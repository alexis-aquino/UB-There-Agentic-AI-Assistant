# Copy to .env. .env is gitignored.

# Which model provider to use:
#   ollama = free, runs on this machine, no API key needed  (default)
#   openai = paid API, requires OPENAI_API_KEY below
LLM_PROVIDER=ollama

# --- Free local provider ---
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# --- Paid OpenAI provider ---
# To switch: set LLM_PROVIDER=openai above, add your key here, then re-run ingest.py
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBED_MODEL=text-embedding-3-small

# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
