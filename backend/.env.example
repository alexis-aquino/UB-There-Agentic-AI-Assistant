# Copy to .env. All optional — defaults work.
# There are no API keys: the brain is built into this project.

# Voice output: piper (free offline voice) | xtts (your cloned voice) | off
VOICE_PROVIDER=piper

# PIPER_VOICE=en_US-lessac-medium
# VOICE_LANGUAGE=en
# FRONTEND_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# --- Accounts ---
# Every new account starts with this password (sign-up default and Google sign-ups).
# DEFAULT_PASSWORD=12345678
# Google sign-in: create an OAuth client ID (type "Web application") in Google Cloud Console,
# add http://localhost:5273 to "Authorized JavaScript origins", and paste the client ID here.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Only Google accounts from this Workspace domain may sign in; everyone else is a guest.
# GOOGLE_DOMAIN=ub.edu.ph

# --- Asking an office (see RUNNING.md) ---
# log = save emails to backend/outbox/ instead of sending; smtp = send for real.
# MAIL_MODE=log
# The app's own Gmail address and a Google "app password" (not the account password).
# SMTP_USER=ubthere.assistant@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# Where office staff open answer links. Set this once the app is hosted somewhere they can reach.
# PUBLIC_BASE_URL=http://localhost:5273
# TICKETS_PER_DAY=5

# --- AI model ---
# Who writes the answers: ollama (default — llama3.2 on this PC, free) or openai (needs a key).
# Handbook search always uses nomic-embed-text in Ollama, so Ollama must run either way.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# For the OpenAI switch — the key stays here in the backend, never in frontend/:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
